<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuanLyKhoHang">

        <!-- Màn hình 1: Đăng nhập (màn hình mở đầu) -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn hình 2: Danh sách sản phẩm -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <!-- Màn hình 3: Thêm sản phẩm -->
        <activity
            android:name=".ui.AddProductActivity"
            android:exported="false" />

        <!-- Màn hình 4: Chi tiết sản phẩm -->
        <activity
            android:name=".ui.ProductDetailActivity"
            android:exported="false" />

    </application>

</manifest>
